# syntax=docker/dockerfile:1

# Build context is the repo root (see docker-compose.yml), matching
# Dockerfile.backend's convention.
FROM node:22-alpine AS builder
WORKDIR /src

RUN corepack enable && corepack prepare pnpm@latest --activate

COPY apps/frontend/package.json apps/frontend/pnpm-lock.yaml apps/frontend/pnpm-workspace.yaml apps/frontend/.npmrc ./
RUN pnpm install --frozen-lockfile

COPY apps/frontend/. .
# @tamagui/metro-plugin writes into this file during the build but the
# resolver needs it to exist beforehand (it's gitignored/dockerignored since
# it's generated output).
RUN touch tamagui-web.css

# EXPO_PUBLIC_* vars are inlined into the client bundle at build time, so the
# API URL the browser will call has to be known here, not just at runtime.
ARG EXPO_PUBLIC_API_URL
ARG EXPO_PUBLIC_SOCKET_URL
ARG EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
# Distinct per deploy (commit SHA in CD, "dev" locally) - used as the React
# Query persister's buster (src/providers/query-provider.tsx) so a new build
# never rehydrates a persisted cache shaped for an older one.
ARG EXPO_PUBLIC_BUILD_ID=dev
ENV EXPO_PUBLIC_API_URL=${EXPO_PUBLIC_API_URL}
ENV EXPO_PUBLIC_SOCKET_URL=${EXPO_PUBLIC_SOCKET_URL}
ENV EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=${EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID}
ENV EXPO_PUBLIC_BUILD_ID=${EXPO_PUBLIC_BUILD_ID}
RUN pnpm expo export -p web

FROM nginx:alpine
RUN adduser -D -u 10001 app
COPY deployments/docker/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /src/dist /usr/share/nginx/html
RUN chown -R app:app /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d \
    && touch /var/run/nginx.pid \
    && chown app:app /var/run/nginx.pid
USER app

EXPOSE 80
