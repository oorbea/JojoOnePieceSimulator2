# syntax=docker/dockerfile:1

# Pinned to the same alpine minor as the runtime stage: the builder's
# vips-dev and the runtime's vips must come from the same apk snapshot,
# since the binary is now dynamically linked against libvips.
FROM golang:1.26-alpine3.22 AS builder
WORKDIR /src
# The base image's Go patch version can lag go.mod's `go` directive; let the
# toolchain fetch the pinned version itself instead of failing the build.
ENV GOTOOLCHAIN=auto

RUN apk add --no-cache build-base pkgconfig vips-dev

COPY apps/backend/go.mod apps/backend/go.sum ./
RUN go mod download

COPY apps/backend/. .
# CGO_ENABLED=1 and -tags vips: see internal/infrastructure/imaging.
RUN CGO_ENABLED=1 GOOS=linux go build -tags vips -o /out/server ./cmd/app
# goose CLI for `docker compose exec backend goose ...` (down/status - `up` is
# already run automatically on server startup, see internal/infrastructure/postgres/migrate.go).
# Built with `go install pkg@version`, not `go build`: cmd/goose pulls extra
# deps (godotenv, xflag, modernc.org/sqlite) that this project's own go.sum
# doesn't track (Go 1.17+ module graph pruning only records checksums for
# what the main module actually imports) - `go build` fails wanting a `go get`
# that -mod=readonly refuses to run. `go install ...@version` resolves the
# module independently instead of relying on this project's go.sum.
RUN CGO_ENABLED=0 GOOS=linux GOBIN=/out go install github.com/pressly/goose/v3/cmd/goose@v3.27.3

FROM alpine:3.22
RUN apk add --no-cache ca-certificates vips \
    && adduser -D -u 10001 app
USER app

COPY --from=builder /out/server /usr/local/bin/server
COPY --from=builder /out/goose /usr/local/bin/goose
# The server embeds these via go:embed (see db/migrations/embed.go) for its
# own startup migration; goose CLI needs them as real files on disk instead.
COPY apps/backend/db/migrations/*.sql /migrations/

EXPOSE 8080
ENTRYPOINT ["server"]
