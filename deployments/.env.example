# Single source of truth for local dev and CI: docker-compose.yml
# interpolation AND the backend container's runtime env, via env_file.
# Local dev is Docker-only - there is no separate host-side .env for
# `go run`/`make run` anymore.
#
# Local Docker dev:  cp .env.example .env   (fill in every [SECRET] value)
# GitHub Actions:    set [SECRET] vars as repository/environment secrets,
#                     [CONFIG] vars as workflow env or repository variables -
#                     compose reads both the same way, no .env file needed.
#
# Production (.github/workflows/cd.yml): every [SECRET]/[CONFIG] below (minus
# FRONTEND_PORT/PORT, dev-only - see docker-compose.dev.yml) must exist as a
# GitHub repository secret ([SECRET]) or variable ([CONFIG]) with the exact
# same name. The CD job dumps them into deployments/.env on the server via
# `toJSON(secrets)`/`toJSON(vars)`, which docker-compose.yml + .prod.yml then
# read the same way as a local .env file.
#
# Extra secrets needed only by the CD pipeline itself (not read by the app,
# so NOT written to deployments/.env - excluded explicitly in cd.yml):
#   TS_OAUTH_CLIENT_ID, TS_OAUTH_SECRET  - Tailscale OAuth client (tag:ci)
#   SERVER_IP, SERVER_USER, SSH_PRIVATE_KEY - SSH access to the deploy target

# ── Postgres ── [SECRET]
POSTGRES_USER=jojo
POSTGRES_PASSWORD=
POSTGRES_DB=jojo_one_piece_simulator
# ── Postgres ── [CONFIG]
POSTGRES_PORT=5432

# ── HTTP ── [CONFIG]
PORT=8080

# ── Auth ── [SECRET]
# Not a secret value itself (OAuth client IDs are public), but treat as one
# operationally: shared with EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID below.
GOOGLE_CLIENT_ID=
JWT_SECRET=
# ── Auth ── [CONFIG]
JWT_ISSUER=jojo-one-piece-simulator
JWT_TTL=24h
ADMIN_EMAILS=

# ── CORS ── [CONFIG]
# CORS_ALLOWED_ORIGINS is not set here - docker-compose.yml derives it from
# FRONTEND_PORT above and injects it directly, since it must always point at
# the frontend service.
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=300

# ── Rate Limiting ── [CONFIG]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_GLOBAL_PER_IP=120
RATE_LIMIT_LOGIN_PER_IP=10
RATE_LIMIT_READ_PER_USER=100
RATE_LIMIT_WRITE_PER_USER=30

# ── Object Storage (Cloudflare R2) ── [SECRET]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# ── Object Storage (Cloudflare R2) ── [CONFIG]
R2_PRESIGN_TTL=15m
# R2's free-tier storage cap (10 GiB). New uploads fall through to the next
# configured provider once R2 is within STORAGE_QUOTA_THRESHOLD_PCT of this.
R2_QUOTA_BYTES=10737418240

# ── Object Storage fallback chain ── [CONFIG]
# Providers are tried in this order; R2 must be first (it's the only one
# that's mandatory). Add "b2" and/or "supabase" here only once their own
# section below is filled in - see deployments/README.md for how to set
# each one up.
STORAGE_PROVIDERS=r2
STORAGE_QUOTA_THRESHOLD_PCT=95
STORAGE_RECONCILE_INTERVAL=6h

# ── Object Storage (Backblaze B2) - only used if STORAGE_PROVIDERS includes
# "b2" ── [SECRET]
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
# ── Object Storage (Backblaze B2) ── [CONFIG]
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
# B2's free-tier storage cap (10 GB). 0 = unlimited (only falls through on
# a runtime error, never on quota).
B2_QUOTA_BYTES=10000000000

# ── Object Storage (Supabase Storage) - only used if STORAGE_PROVIDERS
# includes "supabase" ── [SECRET]
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# ── Object Storage (Supabase Storage) ── [CONFIG]
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_BUCKET=
# Supabase's free-tier storage cap (1 GB) - shared with the whole Supabase
# project, not just this bucket, so keep this conservative.
SUPABASE_QUOTA_BYTES=1000000000

# ── Picture Processing ── [CONFIG]
PICTURE_MAX_BYTES=5242880
PICTURE_ALLOWED_TYPES=image/webp,image/avif,image/jpeg,image/png,image/gif
PICTURE_MAX_DIMENSION=1024
PICTURE_THUMB_DIMENSION=256
PICTURE_WEBP_QUALITY=80
PICTURE_MAX_PIXELS=50000000
PICTURE_WORKERS=2
PICTURE_QUEUE_SIZE=32
PICTURE_JOB_TIMEOUT=30s

# ── Redis / Cache ── [CONFIG]
# REDIS_URL is not set here - docker-compose.yml points it at the redis
# service directly (redis://redis:6379) instead.
CACHE_ENABLED=true
REDIS_DIAL_TIMEOUT=2s
REDIS_OP_TIMEOUT=200ms
CACHE_STAND_TTL=5m
CACHE_DEVIL_FRUIT_TTL=5m
CACHE_NOTFOUND_TTL=30s
CACHE_PRESIGN_TTL=7m30s
CACHE_HTTP_MAX_AGE=0s

# ── Frontend (inlined at build time) ── [CONFIG]
# These only feed the Docker web build (passed as build ARGs, see
# docker-compose.yml). Native/local Expo dev (`expo start --ios/--android`)
# reads apps/frontend/.env instead, which also has IOS/ANDROID client IDs
# not needed here. Keep API_URL/SOCKET_URL/GOOGLE_WEB_CLIENT_ID in sync
# across both files.
# FRONTEND_PORT only matters for docker-compose.dev.yml (host port mapping) -
# prod has no published ports, see docker-compose.prod.yml.
FRONTEND_PORT=3000
# Production value: https://jojo-one-piece-simulator.duckdns.org/api/v1
# (same origin as the frontend - the reverse proxy routes /api to the
# backend service, see deployments/README.md).
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SOCKET_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
