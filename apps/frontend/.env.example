# EXPO_PUBLIC_* vars are inlined into the client bundle at build time — never
# put secrets here. Copy to .env and fill in for local dev.
#
# This file is for native/local Expo dev only (`expo start --ios/--android`,
# outside Docker) — Expo loads .env from this package's own directory, it
# never reads deployments/.env. For `docker compose up` (web target), the
# equivalent vars live in deployments/.env.example instead and are passed in
# as Docker build ARGs. API_URL/SOCKET_URL/GOOGLE_WEB_CLIENT_ID overlap
# between the two files — keep both in sync if you change one. IOS/ANDROID
# client IDs only exist here since Docker only builds the web target.

EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_SOCKET_URL=
