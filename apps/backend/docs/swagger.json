                        "type": "string"
                    }
                },
                "speed": {
                    "type": "string"
                }
            }
        },
        "dto.StandResponse": {
            "type": "object",
            "properties": {
                "attackPower": {
                    "type": "string"
                },
                "attackRange": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "endurance": {
                    "type": "string"
                },
                "evolvesFrom": {
                    "$ref": "#/definitions/dto.StandResponse"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "picture": {
                    "type": "string"
                },
                "potential": {
                    "type": "string"
                },
                "precision": {
                    "type": "string"
                },
                "rarity": {
