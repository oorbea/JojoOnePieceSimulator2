# Consumed by both the Go app (internal/config) and, via `make db-up`/
# `db-down` (which export everything from this file), by deployments/docker-compose.yml.
# Keep DATABASE_URL in sync with the POSTGRES_* values below.

POSTGRES_USER=jojo
POSTGRES_PASSWORD=jojo
POSTGRES_DB=jojo_one_piece_simulator
POSTGRES_PORT=5432

DATABASE_URL=postgres://jojo:jojo@localhost:5432/jojo_one_piece_simulator?sslmode=disable

# HTTP port the backend listens on. Optional - defaults to 8080 if unset.
PORT=8080

# OAuth client id of the "Web application" registered in Google Cloud
# Console. Both the frontend (for the Google sign-in button) and the
# backend (as the required 'aud' when verifying ID tokens) use this same
# value. Not a secret.
GOOGLE_CLIENT_ID=

# Signing key for the backend's own access tokens (HS256). Required, at
# least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=

# Issuer ('iss') embedded in and required of every access token, and how
# long a token stays valid. Both optional.
JWT_ISSUER=jojo-one-piece-simulator
JWT_TTL=24h

# Comma-separated emails that get the ADMIN role on every Google login.
# Removing an email downgrades that user back to USER on their next login.
# Optional - leave empty to have no admins.
ADMIN_EMAILS=

# CORS. CORS_ALLOWED_ORIGINS empty (the default) means deny-all: no
# Access-Control-* headers are ever added, so browsers block any cross-origin
# call exactly as if the server didn't know about CORS. Fill in with the
# frontend's origin(s), comma-separated, to allow it. The other CORS_* vars
# only matter once an origin is configured.
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=300

# Rate limiting. In-process/in-memory (no shared store), so limits are per
# backend replica: running N replicas multiplies the effective limit by N,
# and limits reset on restart. Tiers stack - an authenticated read against
# /stands consumes both the global per-IP budget and the per-user read
# budget. RATE_LIMIT_ENABLED=false disables all tiers, e.g. for local dev.
RATE_LIMIT_ENABLED=true
# Window every *_PER_* limit below is measured over.
RATE_LIMIT_WINDOW=1m
# Applies to every route (including /health and /swagger), keyed by client IP.
RATE_LIMIT_GLOBAL_PER_IP=120
# Applies only to POST /auth/google, keyed by client IP (unauthenticated).
RATE_LIMIT_LOGIN_PER_IP=10
# Applies to GET /stands and GET /stands/{id}, keyed by user id.
RATE_LIMIT_READ_PER_USER=100
# Applies to POST/PUT/PATCH/DELETE /stands (admin only), keyed by user id.
RATE_LIMIT_WRITE_PER_USER=30

# Object storage (Cloudflare R2), used to store Stand and DevilFruit pictures
# uploaded via PATCH /stands/{id}/picture and PATCH /devil-fruits/{id}/picture.
# All four required - the app fails to start without them, same as
# DATABASE_URL. Create an R2 bucket and an API token (R2 dashboard > Manage
# API tokens) scoped to that bucket; the account id is shown in the R2
# dashboard URL / overview page. The bucket itself stays private - reads go
# through a short-lived presigned URL, never a public one.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# How long a presigned picture URL (returned in every Stand/DevilFruit
# response's `picture` field) stays valid before it must be re-fetched via GET
# /stands/{id} or GET /devil-fruits/{id}. Optional.
R2_PRESIGN_TTL=15m

# Limits enforced on PATCH /stands/{id}/picture and PATCH
# /devil-fruits/{id}/picture uploads, both optional. PICTURE_MAX_BYTES also
# sizes the request body guard on those endpoints, so raising it allows
# correspondingly larger request bodies. These gate what is ACCEPTED - the
# output stored in R2 is always WebP, regardless of the uploaded format (see
# the PICTURE_MAX_DIMENSION block below).
PICTURE_MAX_BYTES=5242880
PICTURE_ALLOWED_TYPES=image/webp,image/avif,image/jpeg,image/png,image/gif

# Every accepted upload is compressed in the background by one shared worker
# pool, routed to the Stand or DevilFruit catalogue by the upload's kind:
# PATCH returns 202 with pictureStatus=PENDING (and the previous
# picture/pictureThumb URLs, or "" on a first upload), and the row moves to
# READY once the worker has resized it to WebP and produced a thumbnail, or to
# FAILED if it couldn't. Poll GET /stands/{id} or GET /devil-fruits/{id} to
# observe the transition. Alpha and animation (GIF, animated WebP) are
# preserved. All optional.
#
# Longest side, in pixels, of the delivered picture and its thumbnail. Neither
# ever upscales a smaller source.
PICTURE_MAX_DIMENSION=1024
PICTURE_THUMB_DIMENSION=256
# Lossy WebP quality, 1-100.
PICTURE_WEBP_QUALITY=80
# Decompression-bomb guard: width * height * frames is checked against this
# budget before any decoding happens, so a small file claiming a huge decoded
# size is rejected instead of processed.
PICTURE_MAX_PIXELS=50000000
# Background worker pool size and its bounded queue. A full queue makes PATCH
# return 503 rather than block or silently drop the upload.
PICTURE_WORKERS=2
PICTURE_QUEUE_SIZE=32
PICTURE_JOB_TIMEOUT=30s

# Read cache (Redis) in front of the Stand and DevilFruit repositories and
# picture presign URLs. REDIS_URL empty (the default) turns caching off
# entirely - no connection is ever attempted, so `go run`/`make test` work
# with no Redis around. The cache is fail-open: any Redis error or timeout is
# treated as a miss and the request falls through to Postgres/R2, never fails
# the request. `make db-up` also starts a local Redis, published on
# REDIS_PORT - set REDIS_URL=redis://localhost:${REDIS_PORT} (literally,
# since .env files don't expand vars) to opt into caching for local `go run`.
REDIS_URL=
REDIS_PORT=6379
# Kill switch on top of REDIS_URL, for disabling the cache without unsetting
# the connection string. Optional.
CACHE_ENABLED=true
# Bounds how long a slow/unreachable Redis can add to a request's latency.
REDIS_DIAL_TIMEOUT=2s
REDIS_OP_TIMEOUT=200ms

# How long a cached Stand/DevilFruit (GET /stands, GET /devil-fruits, single
# lookups, filtered listings) and a cached 404 tombstone (repeatedly
# requesting a nonexistent id) can serve stale data if an invalidation is
# ever missed - every write already invalidates the whole cache immediately,
# these are just a backstop.
CACHE_STAND_TTL=5m
CACHE_DEVIL_FRUIT_TTL=5m
CACHE_NOTFOUND_TTL=30s
# How long a presigned picture URL is cached before a fresh one is computed.
# Must stay strictly below R2_PRESIGN_TTL, so a served URL is never close to
# expiring - defaults to half of R2_PRESIGN_TTL when unset.
CACHE_PRESIGN_TTL=7m30s
# Cache-Control max-age (seconds) added to GET /stands, GET /devil-fruits, and
# their single-item routes, alongside an ETag - a matching If-None-Match gets
# 304 with no body. Independent of Redis; 0 disables Cache-Control (the
# ETag/304 handling stays on regardless).
CACHE_HTTP_MAX_AGE=30s
